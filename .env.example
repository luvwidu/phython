ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot (optional — only needed for `friday-bot`)
FRIDAY_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
FRIDAY_TELEGRAM_ALLOWED_IDS=11111111,22222222

# GitHub drop repo (optional — used by drop_to_github tool for cross-device
# delivery from home Mac to work PC. Create a private repo on your personal
# GitHub first, then `gh auth login`).
FRIDAY_DROP_REPO=yourname/friday-drop
